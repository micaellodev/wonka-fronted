# ============================================================
#  Wonka Asistencia — Environment Variables Template
#  Copy this file to .env (or set in your hosting platform).
#  NEVER commit real credentials.
# ============================================================

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# JWT signing secret (required, use a long random string)
JWT_SECRET=""  # obligatorio: >=32 caracteres aleatorios (p.ej. `python -c "import secrets;print(secrets.token_hex(32))"`)

# WebAuthn: your domain (use the public hostname in production)
RP_ID="localhost"
ORIGIN="http://localhost:8000"

# ============================================================
#  Wonka POS — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit real credentials.
# ============================================================

# PostgreSQL connection string (Railway, Neon, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?schema=public"

# Supabase Storage
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="wonka"

# Server port (default: 3000)
PORT=3000

# App environment: development | production
NODE_ENV="development"

# APISPeru — Electronic invoicing (configure in /admin/company per tenant too)
APISPERU_URL="https://facturacion.apisperu.com/api/v1"
APISPERU_TOKEN=""

# SMTP — Email sending (receipts, notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Trust X-Forwarded-For for rate-limit client IP only when behind a reverse proxy (Railway/nginx).
TRUSTED_PROXY=false

# HMAC secret for auth tokens (>=32 chars, REQUIRED in production)
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more


# APISPeru request timeout in ms
APISPERU_TIMEOUT_MS=15000

# Seed only: initial admin PIN
SEED_ADMIN_PIN=0000

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/val/AppData/Local/Programs/Python/Python312/Scripts/graphify.exe hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/val/AppData/Local/Programs/Python/Python312/Scripts/graphify.exe hook-guard read"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "context-bar@claude-code-mods": true
  }
}
